# ── FraudGuard AI — local development overrides ──────────────────────────────
# Copy to `.env` for local work:  cp .env.example .env
# NEVER commit `.env` (it is git-ignored). Production MUST set SECRET_KEY and
# replace the demo credentials below with strong unique values.

# App
DEBUG=true

# REQUIRED in production: long random string (>= 32 chars recommended).
# The app logs a loud warning if the built-in dev default is used with
# DEBUG=false (see config/settings.py::warn_if_insecure_defaults).
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Demo bootstrap users (seeded on startup when SEED_DEFAULT_USERS=true).
# Override in production; set SEED_DEFAULT_USERS=false to disable seeding.
SEED_DEFAULT_USERS=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@fraudguard.ai
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234
DEMO_EMAIL=demo@fraudguard.ai

# Database (default: local SQLite file)
# DATABASE_URL=sqlite:////absolute/path/to/fraud_detection.db

# Rate limits (slowapi format: "<n>/<period>")
# RATE_LIMIT_PREDICT=60/minute
# RATE_LIMIT_TRAIN=3/hour
